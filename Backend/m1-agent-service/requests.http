@baseUrl = http://localhost:8081
@agentId = 12
@basedOnVersionId = 3
@versionId = 4
@providerVersionId = replace-with-created-provider-version-id
@executionId = 1
@outboxEventId = replace-with-outbox-uuid
@devUser = demo-owner
@token = replace-with-a-Keycloak-JWT

### Dev-profile verification: create an agent as USER (expected 201)
POST {{baseUrl}}/api/agents
X-Dev-User: demo-user
X-Dev-Role: USER
Content-Type: application/json

{
  "name": "azert",
  "description": "qqqq",
  "status": "DRAFT"
}

### Dev-profile verification: create an agent as ADMIN (expected 201)
POST {{baseUrl}}/api/agents
X-Dev-User: demo-admin
X-Dev-Role: ADMIN
Content-Type: application/json

{
  "name": "azert",
  "description": "qqqq",
  "status": "DRAFT"
}

### CORS verification (dev allows http://localhost:5173 by default; expected 201)
POST {{baseUrl}}/api/agents
Origin: http://localhost:5173
X-Dev-User: demo-user
X-Dev-Role: USER
Content-Type: application/json

{
  "name": "azert",
  "description": "qqqq",
  "status": "DRAFT"
}

### M5 flow: list the current user's agents
GET {{baseUrl}}/api/agents
Authorization: Bearer {{token}}

### M5 flow: list versions for an owned agent
GET {{baseUrl}}/api/agents/{{agentId}}/versions
Authorization: Bearer {{token}}

### M5 flow: read tunable parameters for the base version
GET {{baseUrl}}/api/agents/{{agentId}}/versions/{{basedOnVersionId}}/tunable-parameters
Authorization: Bearer {{token}}

### M5 flow: create an inactive optimized version
POST {{baseUrl}}/api/agents/{{agentId}}/versions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "basedOnVersionId": {{basedOnVersionId}},
  "source": "M5",
  "studyId": 4,
  "params": {
    "temperature": 0.3,
    "maxTokens": 1024,
    "style": "concise"
  }
}

### Create an agent version with an explicit Groq provider (expected 201)
POST {{baseUrl}}/api/agents/{{agentId}}/versions
X-Dev-User: {{devUser}}
X-Dev-Role: USER
Content-Type: application/json

{
  "provider": "groq",
  "model": "llama-3.3-70b-versatile",
  "systemPrompt": "Réponds de manière concise.",
  "configuration": {
    "temperature": 0.2,
    "maxTokens": 512,
    "style": "concise",
    "maxTurns": 3,
    "timeoutSeconds": 30,
    "allowedToolIds": []
  }
}

### Execute the Groq-backed version (replace providerVersionId; expected 200)
POST {{baseUrl}}/api/agents/{{agentId}}/execute
X-Dev-User: {{devUser}}
X-Dev-Role: USER
Content-Type: application/json

{
  "versionId": {{providerVersionId}},
  "input": "Réponds par OK."
}

### Admin-only provider check (one small real provider request; expected 200)
POST {{baseUrl}}/api/admin/llm/groq/check
X-Dev-User: demo-admin
X-Dev-Role: ADMIN

### M5 flow: activate the created version
PUT {{baseUrl}}/api/agents/{{agentId}}/versions/{{versionId}}/activate
Authorization: Bearer {{token}}

### M5 flow: check service health (no token required)
GET {{baseUrl}}/actuator/health

### Execute with per-run temporary settings
POST {{baseUrl}}/api/agents/{{agentId}}/execute
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "versionId": {{versionId}},
  "input": "Analyse les données de vente.",
  "context": "mission=5; étape=2",
  "overrides": {
    "temperature": 0.1
  }
}

### Failing execution example: unavailable provider or archived agent
POST {{baseUrl}}/api/agents/{{agentId}}/execute
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "versionId": {{versionId}},
  "input": "Réponds par le mot OK."
}

### History list for one agent
GET {{baseUrl}}/api/agents/{{agentId}}/executions?status=COMPLETED&page=0&size=20
Authorization: Bearer {{token}}

### History detail
GET {{baseUrl}}/api/agents/{{agentId}}/executions/{{executionId}}
Authorization: Bearer {{token}}

### Executions across the caller's agents
GET {{baseUrl}}/api/executions?page=0&size=20

### Dev-only identity simulation (ignored unless profile=dev)
GET {{baseUrl}}/api/me
X-Dev-User: {{devUser}}
X-Dev-Role: USER

### Current user and capabilities
GET {{baseUrl}}/api/me
Authorization: {{token}}

### LLM provider/model catalogue
GET {{baseUrl}}/api/llm/models
Authorization: {{token}}

### Agent builder proposal (not saved)
POST {{baseUrl}}/api/agents/assist
Authorization: {{token}}
Content-Type: application/json

{
  "description": "Un assistant qui résume les notes de réunion.",
  "language": "fr"
}

### Agent execution statistics
GET {{baseUrl}}/api/agents/{{agentId}}/stats?days=7
Authorization: {{token}}

### Admin: review users and quotas
GET {{baseUrl}}/api/admin/users
Authorization: {{token}}

### Admin: set a quota override (null restores the default)
PUT {{baseUrl}}/api/admin/users/demo-owner/quota
Authorization: {{token}}
Content-Type: application/json

{
  "maxAgents": 8
}

### Admin: archive an agent with an audit reason
POST {{baseUrl}}/api/admin/agents/{{agentId}}/archive
Authorization: {{token}}
Content-Type: application/json

{
  "reason": "Archive demandée après revue."
}

### Admin: list audit entries
GET {{baseUrl}}/api/admin/audit?page=0&size=20
Authorization: {{token}}

### Admin: inspect outbox counts and latest failures
GET {{baseUrl}}/api/admin/outbox

### Admin: retry one failed event
POST {{baseUrl}}/api/admin/outbox/{{outboxEventId}}/retry
Authorization: Bearer {{token}}
