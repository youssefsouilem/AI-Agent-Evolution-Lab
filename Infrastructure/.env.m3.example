# M3 Compose inputs only. Copy to .env.m3 (ignored by Git).
M3_DB_PASSWORD=replace_with_a_local_database_password
M3_MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password
M3_ORCHESTRATOR_TOKEN=replace_with_a_long_random_internal_token
M3_M1_ENABLED=false
M3_CONFIG_CLIENT_ENABLED=false
M3_CONFIG_SERVER_URL=http://host.docker.internal:8888
M3_CONFIG_PROFILE=default
M3_CONFIG_LABEL=main
M3_EUREKA_ENABLED=false
M3_EUREKA_SERVER_URL=http://host.docker.internal:8761/eureka/
M3_M1_MODE=mock
M3_M1_BASE_URL=http://host.docker.internal:8081
M3_M6_ENABLED=false
M3_M6_BASE_URL=http://host.docker.internal:8086
M3_SECURITY_ENABLED=false
M3_KEYCLOAK_ISSUER_URI=
M3_KEYCLOAK_AUDIENCE=m3-mission-service
M3_AI_ROUTER_AGENT_ID=
M3_AI_ROUTER_VERSION_ID=
M3_EVENTS_ENABLED=false
M3_EVENTS_EXCHANGE=mission.events
M3_EVENTS_ROUTING_KEY=mission.lifecycle
M3_RABBITMQ_USERNAME=m3
M3_RABBITMQ_PASSWORD=replace_with_a_broker_password
M3_M1_BEARER_TOKEN=
M3_MAX_PARALLEL=4
M3_RABBITMQ_HOST=m3-rabbitmq
